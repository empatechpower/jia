# ─── JIA Ideas Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Bubble backend base URL
# Live:    https://jia-ideas.bubbleapps.io/api/1.1
# Staging: https://jia-ideas.bubbleapps.io/version-test/api/1.1
VITE_API_BASE_URL=https://jia-ideas.bubbleapps.io/api/1.1

# CDN base URL for images (Bubble file manager, Cloudflare Images, S3, etc.)
VITE_CDN_URL=https://cdn.jiaideas.com
VITE_CLOUDINARY_CLOUD=your_cloud_name
VITE_CLOUDINARY_PRESET=your_upload_preset
# Optional: Sentry DSN for error tracking
# VITE_SENTRY_DSN=
